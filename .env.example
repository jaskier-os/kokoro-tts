# Kokoro TTS API configuration.
# Copy this file to .env and adjust as needed. Every value has a sane default,
# so an empty .env will still run. Variable names map 1:1 to the pydantic
# Settings fields in api/src/core/config.py (case-insensitive).

# --- Server ---
# Host/interface to bind. 0.0.0.0 listens on all interfaces (good for Docker).
HOST=0.0.0.0
# Port to listen on.
PORT=8880

# --- Device ---
# Use GPU acceleration when available (true/false). Falls back to CPU if no GPU.
USE_GPU=true
# Force a device: cuda, mps, or cpu. Leave empty to auto-detect.
DEVICE_TYPE=

# --- Model and voice locations ---
# Directory holding the model weights, relative to the api/ directory.
# Weights are fetched by ./fetch_models.sh (not committed to the repo).
MODEL_DIR=src/models
# Directory holding the voice packs (.pt), relative to the api/ directory.
VOICES_DIR=src/voices/v1_0
# NOTE: HF_REPO_ID (Hugging Face repo for voice download, default
# hexgrad/Kokoro-82M) is read only by scripts/download_voices.py / fetch_models.sh
# at fetch time. Do NOT put it in .env -- the app rejects unknown settings.
# Export it inline if you need to override: HF_REPO_ID=... ./fetch_models.sh

# --- Output ---
# Directory for generated audio output files.
OUTPUT_DIR=output
# Maximum size of the output directory in MB.
OUTPUT_DIR_SIZE_LIMIT_MB=500
# Default voice used when a request does not specify one.
DEFAULT_VOICE=af_heart
# Optionally override the language/voice code (first letter of voice name).
DEFAULT_VOICE_CODE=
# Allow saving combined/custom voices to disk (true/false).
ALLOW_LOCAL_VOICE_SAVING=false

# --- Audio ---
# Output sample rate in Hz.
SAMPLE_RATE=24000
# Global volume multiplier applied to generated audio.
DEFAULT_VOLUME_MULTIPLIER=1.0

# --- Text processing ---
TARGET_MIN_TOKENS=175
TARGET_MAX_TOKENS=250
ABSOLUTE_MAX_TOKENS=450
ADVANCED_TEXT_NORMALIZATION=true
VOICE_WEIGHT_NORMALIZATION=true
GAP_TRIM_MS=1
DYNAMIC_GAP_TRIM_PADDING_MS=410

# --- Web player UI ---
# Serve the bundled web player UI (true/false).
ENABLE_WEB_PLAYER=true
# Path to the web player static files.
WEB_PLAYER_PATH=web
# Enable CORS (true/false) and the allowed origins (JSON list).
CORS_ENABLED=true
CORS_ORIGINS=["*"]

# --- Temp files (used by the web UI) ---
TEMP_FILE_DIR=api/temp_files
MAX_TEMP_DIR_SIZE_MB=2048
MAX_TEMP_DIR_AGE_HOURS=1
MAX_TEMP_DIR_COUNT=3

# --- espeak-ng (phonemizer backend) ---
# Path to espeak-ng data. Leave empty to use the system default location.
# Common Linux value: /usr/lib/x86_64-linux-gnu/espeak-ng-data
ESPEAK_DATA_PATH=
